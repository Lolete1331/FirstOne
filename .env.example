# ── Supabase ─────────────────────────────────────────────
# Local: salen de `npx supabase status`. Producción: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clave secreta (rol service_role). SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── Anti-bots: Cloudflare Turnstile (opcional en local) ─
# Si se dejan vacías, la verificación se desactiva.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Firma de la cookie "soy humano" (si falta se usa SUPABASE_SECRET_KEY).
HUMAN_COOKIE_SECRET=

# ── Solo para scripts (cargar el diccionario) ───────────
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
